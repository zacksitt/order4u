generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  agent
  cargo
  admin
  customer
}

enum ItemStatus {
  pending_purchase
  purchased
  seller_shipped
  arrived_at_agent
  cancelled
}

enum FulfillmentStatus {
  collecting
  ready_for_cargo
  handed_to_cargo
  cargo_received
  cargo_checking
  cargo_check_ok
  cargo_check_exception
  cargo_invoiced
  in_transit
  delivered
}

enum ProductPaymentStatus {
  awaiting
  paid
}

enum CargoPaymentStatus {
  not_applicable
  awaiting
  paid
}

enum NotificationType {
  handed_to_cargo
  cargo_invoice_ready
  check_exception
}

enum Marketplace {
  shopee
  lazada
  other
}

enum ActionLogEntityType {
  order
  tenant
}

model Tenant {
  id                       String   @id @default(uuid())
  name                     String
  slug                     String   @unique @default("demo-shop")
  defaultAgentId           String?  @map("default_agent_id")
  messengerPageId          String?  @unique @map("messenger_page_id")
  publicOrderFormEnabled   Boolean  @default(true) @map("public_order_form_enabled")
  defaultThbMmkRate        Decimal  @default(92) @map("default_thb_mmk_rate") @db.Decimal(12, 4)
  defaultServiceFeePercent Decimal  @default(7) @map("default_service_fee_percent") @db.Decimal(5, 2)
  paymentInstructions    String?  @map("payment_instructions")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  defaultAgent User? @relation("TenantDefaultAgent", fields: [defaultAgentId], references: [id])
  memberships TenantMembership[]
  customers   Customer[]
  orders      Order[]
  catalogItems CatalogItem[]
  itemCategories ItemCategory[]
  notifications Notification[]
  actionsLogs   ActionsLog[]
  exchangeRates ExchangeRateHistory[]

  @@map("tenants")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String   @map("password_hash")
  displayName         String   @map("display_name")
  isActive            Boolean  @default(true) @map("is_active")
  mustChangePassword  Boolean  @default(false) @map("must_change_password")
  createdAt           DateTime @default(now()) @map("created_at")

  memberships          TenantMembership[]
  customerProfile      Customer?
  ordersAsAgent        Order[] @relation("OrderAgent")
  ordersAsCargo        Order[] @relation("OrderCargoAssignee")
  ordersHandedToCargo  Order[] @relation("OrderHandedBy")
  ordersCreated        Order[] @relation("OrderCreatedBy")
  defaultAgentForTenants Tenant[] @relation("TenantDefaultAgent")
  notifications        Notification[]
  actionsLogsUpdated   ActionsLog[] @relation("ActionsLogUpdater")
  exchangeRatesSet     ExchangeRateHistory[] @relation("ExchangeRateSetter")

  @@map("users")
}

model TenantMembership {
  tenantId String         @map("tenant_id")
  userId   String         @map("user_id")
  role     MembershipRole

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([tenantId, userId, role])
  @@map("tenant_memberships")
}

model Customer {
  id                   String  @id @default(uuid())
  tenantId             String  @map("tenant_id")
  userId               String? @unique @map("user_id")
  name                 String
  /// AES-GCM ciphertext (phone, email, Facebook URL, notes, Messenger PSID).
  phone                String
  phoneHash            String  @default("") @map("phone_hash")
  email                String? @map("email")
  emailHash            String  @default("") @map("email_hash")
  facebookProfileUrl   String? @map("facebook_profile_url")
  notes                String?
  portalAccessToken    String? @unique @map("portal_access_token")
  messengerPsid        String? @map("messenger_psid")
  messengerPsidHash    String? @map("messenger_psid_hash")
  messengerDisplayName String? @map("messenger_display_name")
  trustedBuyBeforePay  Boolean @default(false) @map("trusted_buy_before_pay")
  createdAt            DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@unique([tenantId, messengerPsidHash])
  @@index([tenantId, phoneHash])
  @@index([tenantId, emailHash])
  @@index([tenantId, name])
  @@index([tenantId, createdAt])
  @@map("customers")
}

model ItemCategory {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  name          String
  cargoPriceThb Decimal  @map("cargo_price_thb") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([tenantId, name])
  @@map("item_categories")
}

model CatalogItem {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  name        String
  sourceUrl   String   @map("source_url")
  price       Decimal  @db.Decimal(12, 2)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@map("items")
}

model Order {
  id                    String               @id @default(uuid())
  tenantId              String               @map("tenant_id")
  assignedAgentId       String               @map("assigned_agent_id")
  assignedCargoUserId   String?              @map("assigned_cargo_user_id")
  handedToCargoByUserId String?              @map("handed_to_cargo_by_user_id")
  customerId            String               @map("customer_id")
  createdByUserId       String?              @map("created_by_user_id")
  code                  String
  publicAccessToken     String               @unique @map("public_access_token")
  fulfillmentStatus     FulfillmentStatus    @default(collecting) @map("fulfillment_status")
  productPaymentStatus  ProductPaymentStatus @default(awaiting) @map("product_payment_status")
  cargoPaymentStatus    CargoPaymentStatus   @default(not_applicable) @map("cargo_payment_status")
  productPaidAt         DateTime?            @map("product_paid_at")
  cargoPaidAt           DateTime?            @map("cargo_paid_at")
  trustedEarlyBuy       Boolean              @default(false) @map("trusted_early_buy")
  handedToCargoAt       DateTime?            @map("handed_to_cargo_at")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedAgent    User            @relation("OrderAgent", fields: [assignedAgentId], references: [id])
  assignedCargoUser User?          @relation("OrderCargoAssignee", fields: [assignedCargoUserId], references: [id])
  handedToCargoBy  User?           @relation("OrderHandedBy", fields: [handedToCargoByUserId], references: [id])
  customer         Customer        @relation(fields: [customerId], references: [id])
  createdBy        User?           @relation("OrderCreatedBy", fields: [createdByUserId], references: [id])
  items            OrderItem[]
  productInvoice   ProductInvoice?
  cargoInvoice     CargoInvoice?
  notifications    Notification[]

  @@unique([tenantId, code])
  @@map("orders")
}

model OrderItem {
  id             String     @id @default(uuid())
  orderId        String     @map("order_id")
  catalogItemId  String?    @map("catalog_item_id")
  sortOrder      Int        @default(0) @map("sort_order")
  title          String
  sourceUrl      String     @map("source_url")
  qty            Int
  price          Decimal    @db.Decimal(12, 2)
  shippingFeeThb Decimal    @default(0) @map("shipping_fee_thb") @db.Decimal(12, 2)
  actualPrice    Decimal?   @map("actual_price") @db.Decimal(12, 2)
  status         ItemStatus @default(pending_purchase)
  cargoCheckOk   Boolean?    @map("cargo_check_ok")
  cargoCheckNote String?    @map("cargo_check_note")
  marketplace    Marketplace?
  shopeeShopId   String?     @map("shopee_shop_id")
  shopeeItemId   String?     @map("shopee_item_id")
  itemCategoryId String?    @map("item_category_id")
  customerNote   String?    @map("customer_note")

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem  CatalogItem?  @relation(fields: [catalogItemId], references: [id])
  itemCategory ItemCategory? @relation(fields: [itemCategoryId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model ExchangeRateHistory {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  rate          Decimal  @db.Decimal(12, 4)
  effectiveAt   DateTime @default(now()) @map("effective_at")
  setByUserId   String   @map("set_by_user_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  setBy  User   @relation("ExchangeRateSetter", fields: [setByUserId], references: [id])

  @@index([tenantId, effectiveAt])
  @@map("exchange_rate_history")
}

model ProductInvoice {
  id                String   @id @default(uuid())
  orderId           String   @unique @map("order_id")
  issuedAt          DateTime @default(now()) @map("issued_at")
  thbSubtotal       Decimal  @map("thb_subtotal") @db.Decimal(12, 2)
  thbShipping       Decimal  @map("thb_shipping") @db.Decimal(12, 2)
  serviceFeePercent Decimal  @map("service_fee_percent") @db.Decimal(5, 2)
  serviceFeeThb     Decimal  @map("service_fee_thb") @db.Decimal(12, 2)
  mmkServiceFee     Int      @map("mmk_service_fee")
  rateThbMmk        Decimal  @map("rate_thb_mmk") @db.Decimal(12, 4)
  mmkTotalDue       Int      @map("mmk_total_due")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("product_invoices")
}

model CargoInvoice {
  id                String   @id @default(uuid())
  orderId           String   @unique @map("order_id")
  issuedAt          DateTime @default(now()) @map("issued_at")
  chargeableWeightKg Decimal @map("chargeable_weight_kg") @db.Decimal(8, 2)
  thbTotalDue       Decimal? @map("thb_total_due") @db.Decimal(12, 2)
  subtotalThb       Decimal? @map("subtotal_thb") @db.Decimal(12, 2)
  discountThb       Decimal  @default(0) @map("discount_thb") @db.Decimal(12, 2)
  mmkTotalDue       Int      @map("mmk_total_due")

  order Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines CargoInvoiceLine[]

  @@map("cargo_invoices")
}

/// Snapshot of one category on a cargo invoice; prices can differ from the category default.
model CargoInvoiceLine {
  id             String  @id @default(uuid())
  cargoInvoiceId String  @map("cargo_invoice_id")
  sortOrder      Int     @map("sort_order")
  categoryName   String  @map("category_name")
  qty            Int
  weightKg       Decimal @default(0) @map("weight_kg") @db.Decimal(8, 2)
  /// THB per kg for this category on this invoice.
  unitPriceThb   Decimal @map("unit_price_thb") @db.Decimal(12, 2)
  totalThb       Decimal @map("total_thb") @db.Decimal(12, 2)

  cargoInvoice CargoInvoice @relation(fields: [cargoInvoiceId], references: [id], onDelete: Cascade)

  @@map("cargo_invoice_lines")
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  userId    String           @map("user_id")
  type      NotificationType
  orderId   String           @map("order_id")
  readAt    DateTime?        @map("read_at")
  payload   Json
  createdAt DateTime         @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model ActionsLog {
  id         String              @id @default(uuid())
  tenantId   String              @map("tenant_id")
  entityType ActionLogEntityType @map("entity_type")
  entityId   String              @map("entity_id")
  actions    String[]
  updatedBy  String              @map("updated_by")
  updatedAt  DateTime            @updatedAt @map("updated_at")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updater User   @relation("ActionsLogUpdater", fields: [updatedBy], references: [id])

  @@unique([tenantId, entityType, entityId])
  @@map("actions_logs")
}
