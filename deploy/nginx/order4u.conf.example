# Order4U — Next.js behind nginx
#
# 1. Copy: sudo cp deploy/nginx/order4u.conf.example /etc/nginx/sites-available/order4u
# 2. Replace DOMAIN and SSL paths (or use certbot --nginx)
# 3. sudo ln -sf /etc/nginx/sites-available/order4u /etc/nginx/sites-enabled/
# 4. sudo rm -f /etc/nginx/sites-enabled/default   # else you see "Welcome to nginx"
# 5. Open the site by DOMAIN (server_name), not raw IP — or add default_server (see DEPLOY.md)
# 6. sudo nginx -t && sudo systemctl reload nginx
#
# App must listen on 127.0.0.1:3000 (e.g. pm2: npm run start -- -H 127.0.0.1 -p 3000)
# Set AUTH_URL and APP_URL to https://DOMAIN (no trailing slash)

upstream order4u_next {
    server 127.0.0.1:3000;
    keepalive 64;
}

# Redirect HTTP → HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name order4u.mmappdemo.space;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name order4u.mmappdemo.space;

    # Let's Encrypt (certbot) — adjust paths after: certbot certonly --nginx -d order4u.mmappdemo.space
    ssl_certificate     /etc/letsencrypt/live/order4u.mmappdemo.space/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/order4u.mmappdemo.space/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Logs
    access_log /var/log/nginx/order4u.access.log;
    error_log  /var/log/nginx/order4u.error.log;

    client_max_body_size 10M;

    location / {
        proxy_pass http://order4u_next;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_buffering off;
    }
}
