# Copy to .env.local

DATABASE_URL="postgresql://order4u:order4u@localhost:5433/order4u?schema=public"

# Required for Auth.js — generate: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"

# Production staff PWA: use your HTTPS origin (e.g. https://order4u.mmappdemo.space) for AUTH_URL and APP_URL.
# PWA is disabled on *.ngrok-free.app (interstitial breaks manifest/SW). Force on tunnel: NEXT_PUBLIC_PWA=1 at build time.
AUTH_URL="http://localhost:3000"

# Messenger (local: set APP_URL to your ngrok https URL — see MESSENGER_LOCAL.md)
APP_URL="http://localhost:3000"
META_APP_SECRET=""
MESSENGER_VERIFY_TOKEN=""
MESSENGER_PAGE_ACCESS_TOKEN=""
MESSENGER_PAGE_ID=""
MESSENGER_SETUP_SECRET=""
# MESSENGER_SKIP_SIGNATURE_VERIFY="true"
